{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "nodeVersion": "20.x",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://vee-club.duckdns.org"
      }
    },
    "preview": {
      "distribution": "internal",
      "nodeVersion": "20.x",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://vee-club.duckdns.org"
      }
    },
    "production": {
      "nodeVersion": "20.x",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://vee-club.duckdns.org"
      }
    }
  }
}
