{
  "expo": {
    "name": "Vee",
    "slug": "hridoy5",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/76af2941-e66e-4252-afd1-bed9f3745348",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "vee",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#7C3AED"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vee.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Vee uses the microphone so you can speak in Voice Rooms.",
        "NSCameraUsageDescription": "Vee uses the camera to capture profile photos and stories.",
        "NSPhotoLibraryUsageDescription": "Vee accesses your photo library to upload profile photos and stories.",
        "NSPhotoLibraryAddUsageDescription": "Vee saves media to your photo library.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "buildNumber": "1",
      "bitcode": false
    },
    "android": {
      "backgroundColor": "#FFFFFF",
      "allowBackup": false,
      "package": "com.vee.app",
      "minSdkVersion": 24,
      "targetSdkVersion": 35,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07020F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vee.app"
            },
            {
              "scheme": "vee"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://vee.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/notification_pop.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vee accesses your photo library to upload profile photos and stories.",
          "cameraPermission": "Vee uses the camera to capture profile photos and stories.",
          "microphonePermission": "Vee uses the microphone to record voice stories."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "./plugins/withVoiceForegroundService/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": "https://vee.app"
      },
      "eas": {
        "projectId": "76af2941-e66e-4252-afd1-bed9f3745348"
      }
    },
    "owner": "jegata5150s-team"
  }
}
